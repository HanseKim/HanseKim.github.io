---
import BaseLayout from '../layouts/BaseLayout.astro';
import FanNav from '../components/FanNav.astro';

// 왼쪽 아래에서 오른쪽 위로 걸어 올라가는 발자국 길.
// 대부분은 작은 자국(- - -)이고, 몇 걸음마다 icon.svg 발자국이 찍힌다.
// 버튼에서 끊기지 않고 화면 밖까지 계속 걸어 올라간다.
const STEPS = 20;
const WALK = 42; // deg — 걸어가는 방향
const trail = Array.from({ length: STEPS }, (_, i) => {
  const t = i / (STEPS - 1);
  const side = i % 2 === 0 ? -1 : 1; // 왼발/오른발
  const isPrint = i % 3 === 1; // 중간중간만 진짜 발자국
  return {
    i,
    isPrint,
    left: 10 + t * 72, // % — 왼쪽에서 오른쪽으로
    bottom: 4 + t * 92, // % — 아래에서 위로
    x: side * 1.1, // rem — 두 발을 좌우로 벌린다
    // 발자국은 진행 방향을 향하고, 작은 자국은 그에 수직으로 눕는다
    rot: isPrint ? WALK + side * 7 : WALK - 90 + side * 6,
  };
});

// 빌드 시점 날짜. 배포할 때마다 갱신된다.
const now = new Date();
const pad = (n: number) => String(n).padStart(2, '0');
const built = `${now.getFullYear()}.${pad(now.getMonth() + 1)}.${pad(now.getDate())}`;
---

<BaseLayout title="내가 만든 개발 일지">
  <main class="overflow-hidden relative min-h-screen bg-[#433E49]">
    <!-- 소개. 발자국 길이 오른쪽 위로 향하니 왼쪽 위가 비어 있다 -->
    <div class="absolute left-[7%] top-[7%] max-w-[13rem] sm:top-[13%] sm:max-w-sm">
      <p class="text-sm tracking-widest text-[#928490]">DEVELOPER</p>
      <h1 class="mt-3 text-3xl font-bold text-[#F3E8EB] sm:text-4xl">김세한</h1>
      <p class="mt-4 leading-relaxed text-[#DBC1AD]">
        관심 있는 분야를 찾아보고, 아이디어를 실제 서비스로 만드는 걸 좋아합니다.
      </p>
    </div>

    <!-- 발자국 길 -->
    <div class="absolute inset-0">
      {
        trail.map((s) => (
          <span
            class:list={['mark', s.isPrint ? 'mark-print' : 'mark-dash']}
            style={`left:${s.left}%; bottom:${s.bottom}%; --x:${s.x}rem; --rot:${s.rot}deg; --d:${s.i * 70}ms`}
          />
        ))
      }
    </div>

    <!-- 길의 끝. 누르면 옆으로 펼쳐진다 -->
    <!-- step을 vw로 묶어두면 좁은 화면에서 타일이 밖으로 밀려나 잘리지 않는다 -->
    <div class="absolute left-[55%] top-[26%] -translate-x-1/2">
      <FanNav step="min(11rem, 28vw)" spread="60deg" tilt="45deg">
        <li>
          <a
            href="https://lavish-carpet-8f6.notion.site/38f0070cb764816fbe06c2d38126d472?pvs=74"
            target="_blank"
            rel="noopener noreferrer"
            class="tile bg-[#F3E8EB]"
          >
            <span class="text-2xl">📓</span>
            <span>노션</span>
          </a>
        </li>
        <li>
          <a href="/projects/" class="tile bg-[#DBC1AD]">
            <img src="/coding.svg" alt="" class="w-8 h-8" />
            <span>프로젝트</span>
          </a>
        </li>
        <li>
          <a
            href="https://github.com/HanseKim"
            target="_blank"
            rel="noopener noreferrer"
            class="tile bg-[#928490] text-[#F3E8EB]"
          >
            <span class="text-2xl">🐙</span>
            <span>깃허브</span>
          </a>
        </li>
      </FanNav>
    </div>

    <p
      class="absolute bottom-14 left-1/2 text-sm tracking-widest -translate-x-1/2 text-[#928490] select-none"
    >
      발자국을 따라가 보세요
    </p>

    <footer
      class="absolute bottom-5 left-1/2 text-xs -translate-x-1/2 text-[#928490]/70 select-none"
    >
      © {built} sehankim
    </footer>
  </main>
</BaseLayout>

<style>
  .mark {
    position: absolute;
    display: block;
    translate: calc(-50% + var(--x)) 0;
    rotate: var(--rot);
    /* 아래에서부터 순서대로 찍히듯 나타난다 */
    animation: step-in 600ms cubic-bezier(0.34, 1.56, 0.64, 1) backwards;
    animation-delay: var(--d);
  }

  /* 대부분의 자국: - - - */
  .mark-dash {
    width: 1.6rem;
    height: 0.35rem;
    border-radius: 999px;
    background-color: #928490;
    opacity: 0.55;
  }

  /* 몇 걸음마다 찍히는 진짜 발자국.
     icon.svg가 검정 단색이라 mask로 모양만 떠내고 팔레트 색을 입힌다 */
  .mark-print {
    width: 2.1rem;
    height: 2.3rem;
    background-color: #dbc1ad;
    opacity: 0.85;
    -webkit-mask: url('/icon.svg') no-repeat center / contain;
    mask: url('/icon.svg') no-repeat center / contain;
  }

  @keyframes step-in {
    from {
      opacity: 0;
      scale: 0.4;
    }
  }

  .tile {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    border-radius: 1.25rem;
    color: #433e49;
    font-size: 0.8rem;
    font-weight: 700;
    box-shadow: 0 10px 24px rgb(0 0 0 / 0.3);
    transition: scale 200ms ease;
  }
  .tile:hover {
    scale: 1.06;
  }

  @media (prefers-reduced-motion: reduce) {
    .mark {
      animation: none;
    }
  }
</style>
