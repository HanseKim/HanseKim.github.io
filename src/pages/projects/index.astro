---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FanNav from '../../components/FanNav.astro';

// pinned(페이지 소개)를 맨 앞에, 나머지는 order 역순
const posts = (await getCollection('posts')).sort(
  (a, b) => Number(b.data.pinned) - Number(a.data.pinned) || b.data.order - a.data.order,
);
---

<BaseLayout title="프로젝트 폴더" description="지금까지 만든 것들" bg="#F3E8EB">
  <main class="px-6 py-14 min-h-screen">
    <header class="flex relative z-30 gap-7 items-start mx-auto mb-20 max-w-5xl">
      {/* 홈과 같은 발자국 버튼. 여기서는 아래로 비스듬히 펼쳐진다 */}
      <FanNav
        size="5rem"
        itemSize="4.75rem"
        step="min(8.5rem, 25vw)"
        spread="42deg"
        tilt="50deg"
        triggerBg="#433E49"
        markColor="#F3E8EB"
        alt="메뉴 열기"
      >
        <li>
          <a href="/" class="tile bg-[#433E49] text-[#F3E8EB]">
            <span class="text-xl">🏠</span>
            <span>처음으로</span>
          </a>
        </li>
        <li>
          <a
            href="https://lavish-carpet-8f6.notion.site/38f0070cb764816fbe06c2d38126d472?pvs=74"
            target="_blank"
            rel="noopener noreferrer"
            class="tile bg-[#DBC1AD] text-[#433E49]"
          >
            <span class="text-xl">📓</span>
            <span>노션</span>
          </a>
        </li>
        <li>
          <a
            href="https://github.com/HanseKim"
            target="_blank"
            rel="noopener noreferrer"
            class="tile bg-[#928490] text-[#F3E8EB]"
          >
            <span class="text-xl">🐙</span>
            <span>깃허브</span>
          </a>
        </li>
      </FanNav>

      <div class="pt-1">
        <h1 class="text-4xl font-bold text-[#433E49] sm:text-5xl">프로젝트 폴더</h1>
        <p class="mt-3 text-[#7A6E79]">발자국을 따라 내려가며 지금까지 만든 것들을 볼 수 있어요</p>
        <div class="mt-5 w-16 h-1 rounded-full bg-[#DBC1AD]"></div>
      </div>
    </header>

    <ul class="mx-auto max-w-5xl snake">
      {
        posts.map((post) => (
          <li class="node">
            <a href={`/projects/posts/${post.id}/`} class="card">
              <div class="chip">
                {post.data.iconImage ? (
                  <img src={post.data.iconImage} alt="" class="object-contain w-7 h-7" />
                ) : (
                  <span class="text-2xl">{post.data.icon}</span>
                )}
              </div>
              <h2 class="mt-5 text-xl font-bold text-[#433E49]">{post.data.title}</h2>
              <p class="mt-1 text-sm text-[#7A6E79]">{post.data.date || '소개'}</p>
              <span class="more">자세히 보기 →</span>
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</BaseLayout>

<style>
  /* 헤더 메뉴에 들어가는 타일 */
  .tile {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    border-radius: 1.1rem;
    font-size: 0.7rem;
    font-weight: 700;
    box-shadow: 0 10px 22px rgb(67 62 73 / 0.25);
    transition: scale 200ms ease;
  }
  .tile:hover {
    scale: 1.06;
  }

  /* ── 뱀처럼 꺾여 내려가는 배치 ──
     한 줄은 오른쪽으로, 다음 줄은 왼쪽으로 흐른다.
       1 2 3
       6 5 4
       7 8 9
     열 개수는 브레이크포인트마다 달라지므로, 각 구간에서 nth-child로
     grid-column과 진행 방향(--dir)을 직접 지정한다.
       --dir  1=오른쪽, -1=왼쪽, 0=가로 연결 없음
       --turn 1이면 아래 칸으로 이어진다 */
  .snake {
    --gap: 2.75rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gap);
    /* dense가 없으면 배치 커서가 앞으로만 가서, 되돌아오는 줄(6 5 4)의
       두 번째 칸부터 새 줄로 밀려난다. 빈 칸을 되채우게 한다. */
    grid-auto-flow: row dense;
  }

  .node {
    position: relative;
    /* 좁은 화면(1열)에서는 전부 아래로만 이어진다 */
    --dir: 0;
    --turn: 1;
  }

  @media (min-width: 640px) {
    .snake {
      grid-template-columns: repeat(2, 1fr);
    }
    .node:nth-child(4n + 1) {
      grid-column: 1;
      --dir: 1;
      --turn: 0;
    }
    .node:nth-child(4n + 2) {
      grid-column: 2;
      --dir: 0;
      --turn: 1;
    }
    .node:nth-child(4n + 3) {
      grid-column: 2;
      --dir: -1;
      --turn: 0;
    }
    .node:nth-child(4n + 4) {
      grid-column: 1;
      --dir: 0;
      --turn: 1;
    }
  }

  @media (min-width: 1024px) {
    .snake {
      grid-template-columns: repeat(3, 1fr);
    }
    .node:nth-child(6n + 1) {
      grid-column: 1;
      --dir: 1;
      --turn: 0;
    }
    .node:nth-child(6n + 2) {
      grid-column: 2;
      --dir: 1;
      --turn: 0;
    }
    .node:nth-child(6n + 3) {
      grid-column: 3;
      --dir: 0;
      --turn: 1;
    }
    .node:nth-child(6n + 4) {
      grid-column: 3;
      --dir: -1;
      --turn: 0;
    }
    .node:nth-child(6n + 5) {
      grid-column: 2;
      --dir: -1;
      --turn: 0;
    }
    .node:nth-child(6n + 6) {
      grid-column: 1;
      --dir: 0;
      --turn: 1;
    }
  }

  /* ── 칸과 칸을 잇는 발자국 ──
     ::after = 옆으로, ::before = 아래로.
     icon.svg가 검정 단색이라 mask로 모양만 떠내고 팔레트 색을 입힌다. */
  .node::after,
  .node::before {
    content: '';
    position: absolute;
    width: 1.5rem;
    height: 1.9rem;
    background-color: #928490;
    -webkit-mask: url('/icon.svg') no-repeat center / contain;
    mask: url('/icon.svg') no-repeat center / contain;
    pointer-events: none;
  }

  /* 옆 칸으로. --dir이 0이면 opacity가 0이 되어 사라진다 */
  .node::after {
    top: 50%;
    left: calc(50% + var(--dir) * 50% + var(--dir) * var(--gap) / 2);
    translate: -50% -50%;
    rotate: calc(var(--dir) * 90deg);
    opacity: calc(var(--dir) * var(--dir) * 0.65);
  }

  /* 아래 칸으로 */
  .node::before {
    left: 50%;
    top: calc(100% + var(--gap) / 2);
    translate: -50% -50%;
    rotate: 180deg;
    opacity: calc(var(--turn) * 0.65);
  }

  /* 마지막 칸 뒤에는 이어질 곳이 없다 */
  .node:last-child::after,
  .node:last-child::before {
    display: none;
  }

  /* ── 카드 ── */
  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.75rem;
    border-radius: 1.5rem;
    background-color: #fff;
    border: 1px solid #e6d5cb;
    box-shadow: 0 8px 20px rgb(67 62 73 / 0.08);
    transition:
      translate 240ms ease,
      box-shadow 240ms ease,
      border-color 240ms ease;
  }
  .card:hover {
    translate: 0 -6px;
    border-color: #dbc1ad;
    box-shadow: 0 16px 32px rgb(67 62 73 / 0.16);
  }

  .chip {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 1rem;
    background-color: #dbc1ad;
  }

  .more {
    margin-top: auto;
    padding-top: 1.25rem;
    font-size: 0.8rem;
    font-weight: 700;
    color: #928490;
    transition: color 240ms ease;
  }
  .card:hover .more {
    color: #433e49;
  }

  @media (prefers-reduced-motion: reduce) {
    .card,
    .tile {
      transition: none;
    }
  }
</style>
